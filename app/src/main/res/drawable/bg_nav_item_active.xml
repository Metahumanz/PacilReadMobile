<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeColorAppNavActiveBg" />
            <corners android:radius="?attr/themeRadiusAppNavItem" />
            <stroke
                android:width="1dp"
                android:color="?attr/themeColorAppBorder" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeColorAppPrimary" />
            <size android:height="18dp" android:width="3dp" />
        </shape>
    </item>
</layer-list>
