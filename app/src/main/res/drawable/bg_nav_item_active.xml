<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_nav_active_bg" />
            <corners android:radius="0dp" />
            <stroke
                android:width="1dp"
                android:color="@color/app_border" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_primary" />
            <size android:height="18dp" android:width="3dp" />
        </shape>
    </item>
</layer-list>
