<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自定义字色"
        android:textColor="?attr/themeColorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.metahumanz.pacilread.ui.HsvColorPlaneView
        android:id="@+id/color_plane"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="色相"
        android:textColor="?attr/themeColorOnSurface"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/color_seek_hue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="359" />

    <TextView
        android:id="@+id/color_text_rgb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/themeColorOnSurfaceMuted" />

    <TextView
        android:id="@+id/color_text_hex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/themeColorOnSurfaceMuted" />

    <View
        android:id="@+id/color_preview"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input" />

    <Button
        android:id="@+id/color_button_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_primary_button"
        android:text="应用"
        android:textColor="@android:color/white" />
</LinearLayout>
