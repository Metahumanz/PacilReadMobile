<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reading_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_backdrop"
    android:theme="@style/AppChromeSurfaceTheme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/themeColorAppTextPrimary" />

            <TextView
                android:id="@+id/text_page_title"
                style="@style/AppChromeBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/button_back"
                android:text="阅读统计" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <TextView
                    android:id="@+id/text_sync_status"
                    style="@style/AppChromeCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_period_today"
                        style="@style/AppChromeCompactToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_primary_button"
                        android:text="本日"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeColorAppButtonPrimaryText" />

                    <Button
                        android:id="@+id/button_period_week"
                        style="@style/AppChromeCompactToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_outline_button"
                        android:text="本周"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeColorAppButtonOutlineText" />

                    <Button
                        android:id="@+id/button_period_year"
                        style="@style/AppChromeCompactToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_outline_button"
                        android:text="本年"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeColorAppButtonOutlineText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/text_scope_label"
                        style="@style/AppChromeBodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前范围阅读总时长" />

                    <TextView
                        android:id="@+id/text_scope_total"
                        style="@style/AppChromeMetricValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0 秒"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_scope_chars"
                        style="@style/AppChromeBodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="阅读字数 0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_book_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="104dp"
                            android:background="@drawable/bg_book_cover"
                            android:clipToOutline="true"
                            android:outlineProvider="background">

                            <com.metahumanz.pacilread.ui.BookCoverImageView
                                android:id="@+id/image_cover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/text_cover_fallback"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="PR"
                                android:textColor="?attr/themeColorAppButtonPrimaryText"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_book_title"
                                style="@style/AppChromePageTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="19sp" />

                            <TextView
                                android:id="@+id/text_book_author"
                                style="@style/AppChromeBodyMuted"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/text_book_progress"
                                style="@style/AppChromeBody"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/text_book_last_read"
                                style="@style/AppChromeCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/text_book_speed"
                                style="@style/AppChromeCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/text_book_eta"
                                style="@style/AppChromeCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_calendar_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/AppChromeCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="连续阅读日历"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/layout_reading_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_annual_report_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/AppChromeCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="年度报告"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/layout_annual_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/button_share_annual_report"
                        style="@style/AppChromeCompactToggleButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="46dp"
                        android:background="@drawable/bg_app_primary_button"
                        android:text="生成年度报告"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeColorAppButtonPrimaryText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_list_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/AppChromeCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="按书统计"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/text_list_empty"
                        style="@style/AppChromeBodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="当前范围还没有阅读记录"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/layout_book_stats_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
