<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Windows 11 Style Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/button_back"
                android:fontFamily="sans-serif-medium"
                android:text="设置"
                android:textColor="@color/on_surface"
                android:textSize="20sp" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="20dp"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Appearance Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="个性化与显示"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用主题"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/spinner_app_theme_mode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="阅读器界面主题"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/spinner_reader_ui_theme_mode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input" />

                    <TextView
                        android:id="@+id/text_glass_opacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="毛玻璃不透明度"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <SeekBar
                        android:id="@+id/seek_glass_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="80" />
                </LinearLayout>

                <!-- Navigation Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="操作与导航"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/check_auto_open"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启动时自动打开最后一本书"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="音量上键行为"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/spinner_volume_key_up_action"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="音量下键行为"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/spinner_volume_key_down_action"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input" />
                </LinearLayout>

                <!-- Cloud Sync Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="云端同步 (WebDAV)"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/check_webdav_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启用 WebDAV 同步"
                        android:textColor="@color/on_surface" />

                    <LinearLayout
                        android:id="@+id/layout_webdav_config"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <EditText
                            android:id="@+id/input_webdav_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_input"
                            android:hint="服务器地址 (URL)"
                            android:padding="12dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/input_webdav_dir"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:hint="同步目录名称"
                            android:padding="12dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/input_webdav_user"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:hint="用户名"
                            android:padding="12dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/input_webdav_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:hint="密码 / 授权码"
                            android:inputType="textPassword"
                            android:padding="12dp"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/button_test_webdav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_outline_button"
                            android:text="测试连接并初始化"
                            android:textAllCaps="false"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Backup & Restore Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="数据备份"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_backup_full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="全量备份：从未备份"
                        android:textColor="@color/on_surface_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/button_full_backup"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_positive_button"
                            android:text="立即备份"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white" />

                        <Button
                            android:id="@+id/button_full_restore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_outline_button"
                            android:text="从云端恢复"
                            android:textAllCaps="false"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>
                </LinearLayout>
                
                <!-- Tools Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="实验室与工具"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="80dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MiMo TTS API Key"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/input_mimo_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="输入 Key"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/button_import_books"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_outline_button"
                        android:text="批量导入本地书籍"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Floating Status Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp">

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="状态：就绪"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="12sp" />
    </androidx.cardview.widget.CardView>

</FrameLayout>
