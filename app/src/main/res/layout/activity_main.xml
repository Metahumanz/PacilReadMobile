<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_backdrop">

    <LinearLayout
        android:id="@+id/content_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ========== Compact Top Bar ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/button_open_drawer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:text="☰"
                android:textColor="@color/on_surface"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/text_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="书架大厅"
                android:textColor="@color/on_surface_muted"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ========== Content Area ========== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===== Section: Bookshelf ===== -->
            <LinearLayout
                android:id="@+id/section_bookshelf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="我的书架"
                            android:textColor="@color/on_surface"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/text_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:elevation="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.55"
                                android:text="🔍"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/input_search"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="搜索书名或作者..."
                                android:imeOptions="actionDone"
                                android:paddingStart="0dp"
                                android:paddingTop="10dp"
                                android:paddingEnd="2dp"
                                android:paddingBottom="10dp"
                                android:singleLine="true"
                                android:textColor="@color/on_surface"
                                android:textColorHint="@color/on_surface_muted"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_card"
                            android:elevation="2dp"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <Button
                                android:id="@+id/button_mode_card"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_primary_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="34dp"
                                android:minWidth="0dp"
                                android:paddingStart="10dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="6dp"
                                android:text="▦"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/button_mode_list"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/bg_outline_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="34dp"
                                android:minWidth="0dp"
                                android:paddingStart="10dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="6dp"
                                android:text="☰"
                                android:textAllCaps="false"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/button_header_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_primary_button"
                            android:fontFamily="sans-serif-medium"
                            android:minHeight="38dp"
                            android:minWidth="0dp"
                            android:paddingStart="14dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="8dp"
                            android:text="+ 添加"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Book grid / list / empty -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="1">

                    <GridView
                        android:id="@+id/grid_books"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:columnWidth="148dp"
                        android:gravity="top"
                        android:horizontalSpacing="8dp"
                        android:listSelector="@android:color/transparent"
                        android:numColumns="auto_fit"
                        android:overScrollMode="never"
                        android:paddingBottom="6dp"
                        android:scrollbarStyle="outsideOverlay"
                        android:stretchMode="columnWidth"
                        android:verticalSpacing="8dp" />

                    <ListView
                        android:id="@+id/list_books"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="8dp"
                        android:listSelector="@android:color/transparent"
                        android:overScrollMode="never"
                        android:paddingBottom="6dp"
                        android:scrollbarStyle="outsideOverlay"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layout_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:background="@drawable/bg_card"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="28dp"
                            android:paddingTop="30dp"
                            android:paddingEnd="28dp"
                            android:paddingBottom="30dp">

                            <TextView
                                android:layout_width="68dp"
                                android:layout_height="68dp"
                                android:background="@drawable/bg_primary_button"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="@android:color/white"
                                android:textSize="31sp" />

                            <TextView
                                android:id="@+id/text_empty_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/empty_bookshelf"
                                android:textColor="@color/on_surface"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/text_empty_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:text="@string/empty_bookshelf_hint"
                                android:textColor="@color/on_surface_muted"
                                android:textSize="14sp" />

                            <Button
                                android:id="@+id/button_empty_action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:background="@drawable/bg_primary_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="44dp"
                                android:minWidth="0dp"
                                android:paddingStart="18dp"
                                android:paddingTop="10dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="10dp"
                                android:text="添加书籍"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- ===== Section: Preview (typography) ===== -->
            <ScrollView
                android:id="@+id/section_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="排版与预览"
                            android:textColor="@color/on_surface"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="全局控制阅读引擎的文字排版、视觉主题与页面布局。"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Theme summary -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="阅读引擎实时效果映射"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/text_preview_theme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_soft_button"
                            android:padding="14dp"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Reader preview (flat, no phone shell) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="阅读页预览"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp" />

                        <!-- Flat reader preview area -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="360dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_reader_stage">

                            <ImageView
                                android:id="@+id/image_preview_reader_background"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />

                            <View
                                android:id="@+id/view_preview_reader_scrim"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/overlay_light" />

                            <!-- Reader text area -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <TextView
                                    android:id="@+id/text_preview_reader_heading"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="前言"
                                    android:textColor="@color/on_surface"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/text_preview_reader_body"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="14dp"
                                    android:layout_weight="1"
                                    android:lineSpacingExtra="5sp"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <Button
                            android:id="@+id/button_preview_open_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_outline_button"
                            android:fontFamily="sans-serif-medium"
                            android:minHeight="44dp"
                            android:text="进入设置调排版"
                            android:textAllCaps="false"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ===== Section: Settings (embedded) ===== -->
            <ScrollView
                android:id="@+id/section_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="偏好设置"
                            android:textColor="@color/on_surface"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="定制 PacilRead 的各项核心行为与界面特质"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Theme card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="界面主题"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="应用与阅读界面可以分开控制明暗。"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="应用主题"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_app_theme_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="阅读界面"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_reader_ui_theme_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="阅读菜单不透明度"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seek_glass_opacity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="80" />

                        <TextView
                            android:id="@+id/text_glass_opacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Reading habits -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="阅读习惯"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp" />

                        <CheckBox
                            android:id="@+id/check_auto_open"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:buttonTint="@color/primary"
                            android:text="启动时自动回到最近阅读"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- WebDAV -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="WebDAV 云同步"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp" />

                        <CheckBox
                            android:id="@+id/check_webdav_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:buttonTint="@color/primary"
                            android:text="启用 WebDAV 进度同步"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/input_webdav_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_input"
                            android:hint="服务器地址"
                            android:padding="14dp"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/on_surface_muted"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/input_webdav_dir"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input"
                            android:hint="子目录"
                            android:padding="14dp"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/on_surface_muted"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/input_webdav_user"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input"
                            android:hint="用户名"
                            android:padding="14dp"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/on_surface_muted"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/input_webdav_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input"
                            android:hint="密码"
                            android:inputType="textPassword"
                            android:padding="14dp"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/on_surface_muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/text_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_soft_button"
                            android:lineSpacingExtra="2dp"
                            android:padding="14dp"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/button_test_webdav"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_outline_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="42dp"
                                android:text="@string/settings_test"
                                android:textAllCaps="false"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- MiMo TTS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="MiMo 听书"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp" />

                        <EditText
                            android:id="@+id/input_mimo_api_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_input"
                            android:hint="输入 MiMo API Key"
                            android:inputType="textPassword"
                            android:padding="14dp"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/on_surface_muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Backup -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="备份与恢复"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/text_backup_full"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_soft_button"
                            android:padding="14dp"
                            android:text="全量备份：尚未执行"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/button_full_backup"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_positive_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="42dp"
                                android:text="全量备份"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/button_full_restore"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_outline_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="42dp"
                                android:text="全量恢复"
                                android:textAllCaps="false"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_backup_lite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_soft_button"
                            android:padding="14dp"
                            android:text="增量备份：尚未执行"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/button_lite_backup"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_positive_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="42dp"
                                android:text="增量备份"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/button_lite_restore"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_outline_button"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="42dp"
                                android:text="增量恢复"
                                android:textAllCaps="false"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/include_app_drawer" />

    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66F4F8FD"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="处理中..."
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
