<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_bookmarks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:padding="18dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_home_sidebar_bookmarks"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_nav_item_idle"
                android:contentDescription="打开侧栏"
                android:padding="9dp"
                android:scaleType="center"
                android:src="@drawable/ic_home_menu"
                app:tint="?attr/themeColorAppNavTextIdle"
                android:visibility="gone" />

            <TextView
                style="@style/AppChromeBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="书签" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_home_bookmarks_empty"
            style="@style/AppChromeBodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="暂无书签" />

        <LinearLayout
            android:id="@+id/layout_home_bookmarks_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
