<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_backdrop">

    <LinearLayout
        android:id="@+id/content_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ========== Top Bar ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/button_open_drawer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="☰"
                android:textColor="@color/on_surface"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="书架大厅"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:visibility="visible" />

            <Button
                android:id="@+id/button_header_action"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="+ 添加"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ========== Bookshelf Content ========== -->
        <LinearLayout
            android:id="@+id/section_bookshelf"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <!-- Search and Mode Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <LinearLayout
                    android:id="@+id/container_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/icon_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:text="🔍"
                        android:textSize="14sp"
                        android:clickable="true" />

                    <EditText
                        android:id="@+id/input_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="搜索书名或作者..."
                        android:imeOptions="actionSearch"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/on_surface_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <Button
                        android:id="@+id/button_mode_card"
                        android:layout_width="38dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_primary_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="▦"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/button_mode_list"
                        android:layout_width="38dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_outline_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="☰"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/on_surface_muted"
                android:textSize="11sp" />

            <!-- Book grid / list / empty -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1">

                <GridView
                    android:id="@+id/grid_books"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:columnWidth="148dp"
                    android:gravity="top"
                    android:horizontalSpacing="8dp"
                    android:listSelector="@android:color/transparent"
                    android:numColumns="auto_fit"
                    android:overScrollMode="never"
                    android:paddingBottom="6dp"
                    android:scrollbars="none"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="8dp" />

                <ListView
                    android:id="@+id/list_books"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="8dp"
                    android:listSelector="@android:color/transparent"
                    android:overScrollMode="never"
                    android:paddingBottom="6dp"
                    android:scrollbars="none"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="28dp"
                        android:paddingTop="30dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="30dp">

                        <TextView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/bg_primary_button"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@android:color/white"
                            android:textSize="31sp" />

                        <TextView
                            android:id="@+id/text_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/empty_bookshelf"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/text_empty_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/empty_bookshelf_hint"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/button_empty_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_primary_button"
                            android:fontFamily="sans-serif-medium"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:paddingStart="18dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="10dp"
                            android:text="添加书籍"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/include_app_drawer" />

    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66F4F8FD"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="处理中..."
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
