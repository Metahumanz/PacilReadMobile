<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_backdrop"
    android:theme="@style/AppChromeSurfaceTheme">

    <LinearLayout
        android:id="@+id/home_root_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/home_fixed_sidebar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/content_shell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/page_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <include layout="@layout/include_home_bookshelf_section" />

                <include layout="@layout/include_home_stats_section" />

                <include layout="@layout/include_home_bookmarks_section" />

                <include layout="@layout/include_home_settings_section" />
            </FrameLayout>

            <include layout="@layout/include_home_bottom_navigation" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/home_sidebar_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="?attr/themeColorAppScrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/home_slide_sidebar_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="18dp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/themeColorAppScrim"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_loading"
                style="@style/AppChromeBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="处理中..." />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
