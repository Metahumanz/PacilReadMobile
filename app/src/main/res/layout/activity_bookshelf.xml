<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_backdrop"
    android:theme="@style/AppChromeSurfaceTheme">

    <LinearLayout
        android:id="@+id/home_root_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/home_fixed_sidebar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/content_shell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/section_bookshelf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/text_section_title"
                        style="@style/AppChromeBarTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="书架" />

                    <Button
                        android:id="@+id/button_header_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_app_primary_button"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="+ 添加"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeColorAppButtonPrimaryText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="4dp">

                        <LinearLayout
                            android:id="@+id/container_search"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_app_input"
                            android:clickable="true"
                            android:elevation="2dp"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="2dp">

                            <TextView
                                android:id="@+id/icon_search"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.7"
                                android:clickable="true"
                                android:text="🔍"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/input_search"
                                style="@style/AppChromeInputText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@android:color/transparent"
                                android:hint="搜索书名或作者..."
                                android:imeOptions="actionSearch"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:singleLine="true" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_app_card"
                            android:elevation="2dp"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <Button
                                android:id="@+id/button_mode_card"
                                android:layout_width="38dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_app_primary_button"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="▦"
                                android:textColor="?attr/themeColorAppButtonPrimaryText" />

                            <Button
                                android:id="@+id/button_mode_list"
                                android:layout_width="38dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/bg_app_outline_button"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="☰"
                                android:textColor="?attr/themeColorAppButtonOutlineText" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_stats"
                        style="@style/AppChromeMicro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="14dp"
                        android:layout_weight="1">

                        <GridView
                            android:id="@+id/grid_books"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:columnWidth="148dp"
                            android:gravity="top"
                            android:horizontalSpacing="8dp"
                            android:listSelector="@android:color/transparent"
                            android:numColumns="auto_fit"
                            android:overScrollMode="never"
                            android:paddingBottom="6dp"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="8dp" />

                        <ListView
                            android:id="@+id/list_books"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:divider="@android:color/transparent"
                            android:dividerHeight="4dp"
                            android:listSelector="@android:color/transparent"
                            android:overScrollMode="never"
                            android:paddingTop="1dp"
                            android:paddingBottom="10dp"
                            android:scrollbars="none"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layout_empty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_app_card"
                                android:elevation="6dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="28dp"
                                android:paddingTop="30dp"
                                android:paddingEnd="28dp"
                                android:paddingBottom="30dp">

                                <TextView
                                    android:layout_width="68dp"
                                    android:layout_height="68dp"
                                    android:background="@drawable/bg_app_primary_button"
                                    android:gravity="center"
                                    android:text="+"
                                    android:textColor="?attr/themeColorAppButtonPrimaryText"
                                    android:textSize="31sp" />

                                <TextView
                                    android:id="@+id/text_empty_title"
                                    style="@style/AppChromePageTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="@string/empty_bookshelf" />

                                <TextView
                                    android:id="@+id/text_empty_hint"
                                    style="@style/AppChromeBodyMuted"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:text="@string/empty_bookshelf_hint" />

                                <Button
                                    android:id="@+id/button_empty_action"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:background="@drawable/bg_app_primary_button"
                                    android:minWidth="0dp"
                                    android:minHeight="44dp"
                                    android:paddingStart="18dp"
                                    android:paddingTop="10dp"
                                    android:paddingEnd="18dp"
                                    android:paddingBottom="10dp"
                                    android:text="添加书籍"
                                    android:textAllCaps="false"
                                    android:textColor="?attr/themeColorAppButtonPrimaryText" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/section_reading_stats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="28dp">

                    <TextView
                        style="@style/AppChromeBarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="阅读时长" />

                    <TextView
                        android:id="@+id/text_home_stats_status"
                        style="@style/AppChromeCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="正在加载阅读统计..." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/button_home_stats_today"
                            style="@style/AppChromeCompactToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_app_primary_button"
                            android:text="本日"
                            android:textAllCaps="false"
                            android:textColor="?attr/themeColorAppButtonPrimaryText" />

                        <Button
                            android:id="@+id/button_home_stats_week"
                            style="@style/AppChromeCompactToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_app_outline_button"
                            android:text="本周"
                            android:textAllCaps="false"
                            android:textColor="?attr/themeColorAppButtonOutlineText" />

                        <Button
                            android:id="@+id/button_home_stats_year"
                            style="@style/AppChromeCompactToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_app_outline_button"
                            android:text="本年"
                            android:textAllCaps="false"
                            android:textColor="?attr/themeColorAppButtonOutlineText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_app_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            style="@style/AppChromeBodyMuted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="当前范围阅读总时长" />

                        <TextView
                            android:id="@+id/text_home_stats_total"
                            style="@style/AppChromeMetricValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="0 秒"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_app_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            style="@style/AppChromeCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="按书统计"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/text_home_stats_empty"
                            style="@style/AppChromeBodyMuted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="当前范围还没有阅读记录"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/layout_home_stats_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/section_bookmarks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="28dp">

                    <TextView
                        style="@style/AppChromeBarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="书签" />

                    <TextView
                        android:id="@+id/text_home_bookmarks_empty"
                        style="@style/AppChromeBodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="暂无书签" />

                    <LinearLayout
                        android:id="@+id/layout_home_bookmarks_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/section_home_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="28dp">

                    <TextView
                        style="@style/AppChromeBarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_app_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <CheckBox
                            android:id="@+id/check_home_reading_time_tracking"
                            style="@style/AppChromeCheckBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="记录阅读时长" />

                        <TextView
                            style="@style/AppChromeBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="底栏样式" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/button_home_nav_icons"
                                style="@style/AppChromeCompactToggleButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_app_primary_button"
                                android:text="图标"
                                android:textAllCaps="false"
                                android:textColor="?attr/themeColorAppButtonPrimaryText" />

                            <Button
                                android:id="@+id/button_home_nav_text"
                                style="@style/AppChromeCompactToggleButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_app_outline_button"
                                android:text="文字"
                                android:textAllCaps="false"
                                android:textColor="?attr/themeColorAppButtonOutlineText" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/button_open_full_settings"
                            style="@style/AppChromeCompactToggleButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_app_outline_button"
                            android:minHeight="46dp"
                            android:text="更多偏好设置"
                            android:textAllCaps="false"
                            android:textColor="?attr/themeColorAppButtonOutlineText" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="?attr/themeColorAppSurface"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/nav_home_bookshelf"
                style="@style/AppChromeBodyStrong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="书架"
                android:gravity="center"
                android:text="▦"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nav_home_stats"
                style="@style/AppChromeBodyStrong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="时长"
                android:gravity="center"
                android:text="◷"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nav_home_bookmarks"
                style="@style/AppChromeBodyStrong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="书签"
                android:gravity="center"
                android:text="★"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nav_home_settings"
                style="@style/AppChromeBodyStrong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="设置"
                android:gravity="center"
                android:text="⚙"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/home_sidebar_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="?attr/themeColorAppScrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/home_slide_sidebar_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="18dp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/themeColorAppScrim"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_loading"
                style="@style/AppChromeBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="处理中..." />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
