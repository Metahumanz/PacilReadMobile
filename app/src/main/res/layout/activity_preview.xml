<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_backdrop"
    android:theme="@style/AppChromeSurfaceTheme">

    <LinearLayout
        android:id="@+id/content_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ========== Top Bar ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/button_open_drawer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="☰"
                android:textColor="?attr/themeColorAppTextPrimary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_section_title"
                style="@style/AppChromeBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="排版与预览" />
        </LinearLayout>

        <!-- ========== Preview Content ========== -->
        <ScrollView
            android:id="@+id/section_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/AppChromePageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="排版与预览" />

                    <TextView
                        style="@style/AppChromeBodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="全局控制阅读引擎的文字排版、视觉主题与页面布局。" />
                </LinearLayout>

                <!-- Theme summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/AppChromeCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="阅读引擎实时效果映射" />

                    <TextView
                        android:id="@+id/text_preview_theme"
                        style="@style/AppChromeBodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_app_soft_button"
                        android:padding="14dp" />
                </LinearLayout>

                <!-- Reader preview (flat) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/AppChromeCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="阅读页预览" />

                    <FrameLayout
                        android:id="@+id/layout_preview_reader_stage"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_reader_stage">

                        <ImageView
                            android:id="@+id/image_preview_reader_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <View
                            android:id="@+id/view_preview_reader_scrim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/themeColorOverlayLight" />

                        <LinearLayout
                            android:id="@+id/layout_preview_reader_page"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="18dp">

                            <LinearLayout
                                android:id="@+id/layout_preview_reader_left_page"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/text_preview_reader_heading"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:text="前言"
                                    android:textColor="?attr/themeColorOnSurface"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <com.metahumanz.pacilread.reader.JustifiedPageTextView
                                    android:id="@+id/text_preview_reader_body"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="14dp"
                                    android:layout_weight="1"
                                    android:includeFontPadding="false"
                                    android:lineSpacingExtra="5sp"
                                    android:textColor="?attr/themeColorOnSurface"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <View
                                android:id="@+id/view_preview_reader_gutter"
                                android:layout_width="18dp"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/layout_preview_reader_right_page"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/text_preview_reader_heading_right"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:text="第一章"
                                    android:textColor="?attr/themeColorOnSurface"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                                <com.metahumanz.pacilread.reader.JustifiedPageTextView
                                    android:id="@+id/text_preview_reader_body_right"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="14dp"
                                    android:layout_weight="1"
                                    android:includeFontPadding="false"
                                    android:lineSpacingExtra="5sp"
                                    android:textColor="?attr/themeColorOnSurface"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    layout="@layout/include_preview_style_panel" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/include_app_drawer" />

</FrameLayout>
