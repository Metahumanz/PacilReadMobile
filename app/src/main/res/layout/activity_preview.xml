<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_backdrop">

    <LinearLayout
        android:id="@+id/content_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ========== Top Bar ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/button_open_drawer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:text="☰"
                android:textColor="@color/on_surface"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="排版与预览"
                android:textColor="@color/on_surface"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ========== Preview Content ========== -->
        <ScrollView
            android:id="@+id/section_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="排版与预览"
                        android:textColor="@color/on_surface"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="全局控制阅读引擎的文字排版、视觉主题与页面布局。"
                        android:textColor="@color/on_surface_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Theme summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="阅读引擎实时效果映射"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/text_preview_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_soft_button"
                        android:padding="14dp"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Reader preview (flat) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="阅读页预览"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_reader_stage">

                        <ImageView
                            android:id="@+id/image_preview_reader_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <View
                            android:id="@+id/view_preview_reader_scrim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/overlay_light" />

                        <LinearLayout
                            android:id="@+id/layout_preview_reader_page"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:id="@+id/text_preview_reader_heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="前言"
                                android:textColor="@color/on_surface"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <com.metahumanz.pacilread.reader.JustifiedPageTextView
                                android:id="@+id/text_preview_reader_body"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="14dp"
                                android:layout_weight="1"
                                android:lineSpacingExtra="5sp"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    layout="@layout/include_preview_style_panel" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/include_app_drawer" />

</FrameLayout>
