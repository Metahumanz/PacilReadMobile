<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="听书设置"
        android:textColor="?attr/themeColorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="引擎"
        android:textColor="?attr/themeColorOnSurface"
        android:textStyle="bold" />

        <Spinner
            android:id="@+id/tts_spinner_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="语速"
        android:textColor="?attr/themeColorOnSurface"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/tts_seek_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="15" />

    <TextView
        android:id="@+id/tts_text_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/themeColorOnSurfaceMuted" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="睡眠定时"
        android:textColor="?attr/themeColorOnSurface"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_reader_menu_panel_solid"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/tts_button_timer_slider_mode"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="滑块"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/tts_button_timer_precise_mode"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="精确"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tts_layout_timer_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/tts_seek_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="36" />

        <TextView
            android:id="@+id/tts_text_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:textColor="?attr/themeColorOnSurfaceMuted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tts_layout_timer_precise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <NumberPicker
            android:id="@+id/tts_picker_timer_hours"
            android:layout_width="72dp"
            android:layout_height="96dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <NumberPicker
            android:id="@+id/tts_picker_timer_minutes"
            android:layout_width="72dp"
            android:layout_height="96dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <NumberPicker
            android:id="@+id/tts_picker_timer_seconds"
            android:layout_width="72dp"
            android:layout_height="96dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="秒"
            android:textColor="?attr/themeColorOnSurfaceMuted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tts_layout_mimo_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MiMo 音色"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/tts_spinner_mimo_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tts_layout_system_engine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="系统引擎"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/tts_spinner_system_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tts_text_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="选择朗读引擎后即可开始听书。"
        android:textColor="?attr/themeColorOnSurfaceMuted"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/tts_check_reader_quick_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/tts_show_quick_controls"
        android:textColor="?attr/themeColorOnSurface" />

    <Button
        android:id="@+id/tts_button_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_primary_button"
        android:text="开始听书"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/tts_button_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:text="停止听书"
        android:textColor="?attr/themeColorOnSurface"
        android:visibility="gone" />
</LinearLayout>
