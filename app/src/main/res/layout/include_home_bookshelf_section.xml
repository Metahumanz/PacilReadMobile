<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_bookshelf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/button_home_sidebar_bookshelf"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nav_item_idle"
            android:contentDescription="打开侧栏"
            android:padding="9dp"
            android:scaleType="center"
            android:src="@drawable/ic_home_menu"
            app:tint="?attr/themeColorAppNavTextIdle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_section_title"
            style="@style/AppChromeBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="书架" />

        <Button
            android:id="@+id/button_header_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_primary_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="+ 添加"
            android:textAllCaps="false"
            android:textColor="?attr/themeColorAppButtonPrimaryText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/container_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_app_input"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/icon_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:clickable="true"
                    android:text="🔍"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/input_search"
                    style="@style/AppChromeInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:hint="搜索书名或作者..."
                    android:imeOptions="actionSearch"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_app_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:padding="3dp">

                <Button
                    android:id="@+id/button_mode_card"
                    android:layout_width="38dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_app_primary_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="▦"
                    android:textColor="?attr/themeColorAppButtonPrimaryText" />

                <Button
                    android:id="@+id/button_mode_list"
                    android:layout_width="38dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_app_outline_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="☰"
                    android:textColor="?attr/themeColorAppButtonOutlineText" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_stats"
            style="@style/AppChromeMicro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/grid_books"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:columnWidth="148dp"
                android:gravity="top"
                android:horizontalSpacing="8dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="auto_fit"
                android:overScrollMode="never"
                android:paddingBottom="6dp"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="8dp" />

            <ListView
                android:id="@+id/list_books"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp"
                android:listSelector="@android:color/transparent"
                android:overScrollMode="never"
                android:paddingTop="1dp"
                android:paddingBottom="10dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_app_card"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="30dp">

                    <TextView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_app_primary_button"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="?attr/themeColorAppButtonPrimaryText"
                        android:textSize="31sp" />

                    <TextView
                        android:id="@+id/text_empty_title"
                        style="@style/AppChromePageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/empty_bookshelf" />

                    <TextView
                        android:id="@+id/text_empty_hint"
                        style="@style/AppChromeBodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/empty_bookshelf_hint" />

                    <Button
                        android:id="@+id/button_empty_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_app_primary_button"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="18dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="10dp"
                        android:text="添加书籍"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeColorAppButtonPrimaryText" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
