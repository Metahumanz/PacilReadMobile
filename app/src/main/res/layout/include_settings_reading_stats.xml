<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        style="@style/AppChromeSectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="10dp"
        android:text="阅读时长统计" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_app_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="18dp">

        <CheckBox
            android:id="@+id/check_reading_time_tracking"
            style="@style/AppChromeCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="记录阅读时长" />

        <LinearLayout
            android:id="@+id/layout_reading_stats_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_reading_stats_hint"
                style="@style/AppChromeCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前范围阅读总时长" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_stats_period_today"
                    style="@style/AppChromeCompactToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_primary_button"
                    android:text="本日"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeColorAppButtonPrimaryText" />

                <Button
                    android:id="@+id/button_stats_period_week"
                    style="@style/AppChromeCompactToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_outline_button"
                    android:text="本周"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeColorAppButtonOutlineText" />

                <Button
                    android:id="@+id/button_stats_period_year"
                    style="@style/AppChromeCompactToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_outline_button"
                    android:text="本年"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeColorAppButtonOutlineText" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_reading_stats_total"
                style="@style/AppChromeMetricValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0 秒"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_open_reading_stats"
                style="@style/AppChromeCompactToggleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="46dp"
                android:background="@drawable/bg_app_outline_button"
                android:text="查看详细统计"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorAppButtonOutlineText" />
        </LinearLayout>
    </LinearLayout>
</merge>
