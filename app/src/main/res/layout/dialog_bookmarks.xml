<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="书签"
            android:textColor="?attr/themeColorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/bookmark_button_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_outline_button"
            android:minHeight="40dp"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="关闭"
            android:textAllCaps="false"
            android:textColor="?attr/themeColorOnSurface"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/bookmark_button_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_primary_button"
        android:minHeight="48dp"
        android:text="添加书签"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bookmark_empty_text"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center"
        android:text="本书还没有书签"
        android:textColor="?attr/themeColorOnSurfaceMuted"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/bookmark_body"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/bookmark_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="42dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bookmark_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="2dp" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/bookmark_scrubber_host"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:layout_gravity="end">

            <View
                android:id="@+id/bookmark_scrubber_track"
                android:layout_width="8dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_toc_scrubber_track" />

            <View
                android:id="@+id/bookmark_scrubber_thumb"
                android:layout_width="24dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_toc_scrubber_thumb"
                android:elevation="6dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
