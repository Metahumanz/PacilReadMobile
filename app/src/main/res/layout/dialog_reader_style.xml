<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="阅读样式"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="界面明暗"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/style_spinner_ui_theme_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="阅读预设"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_button_theme_paper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="纸控"
                android:textAllCaps="false"
                android:textColor="@color/on_surface" />

            <Button
                android:id="@+id/style_button_theme_forest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="护眼"
                android:textAllCaps="false"
                android:textColor="@color/on_surface" />

            <Button
                android:id="@+id/style_button_theme_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="夜航"
                android:textAllCaps="false"
                android:textColor="@color/on_surface" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字体"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/style_spinner_font_family"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字色"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/style_spinner_text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/style_text_text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="字色预览"
            android:textColor="@color/on_surface_muted" />

        <Button
            android:id="@+id/style_button_custom_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button"
            android:minHeight="44dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="自定义字色（RGB）"
            android:textAllCaps="false"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字号"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <TextView
            android:id="@+id/style_text_font"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字重"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_font_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2" />

        <TextView
            android:id="@+id/style_text_font_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="行距"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_line_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="28" />

        <TextView
            android:id="@+id/style_text_line_spacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="左右边距"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_side_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40" />

        <TextView
            android:id="@+id/style_text_side_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="上下边距"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_vertical_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="64" />

        <TextView
            android:id="@+id/style_text_vertical_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字间距"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_letter_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/style_text_letter_spacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="首行缩进"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_first_line_indent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="8" />

        <TextView
            android:id="@+id/style_text_first_line_indent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="章节标题对齐"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_button_title_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="靠左"
                android:textAllCaps="false"
                android:textColor="@color/on_surface" />

            <Button
                android:id="@+id/style_button_title_center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="居中"
                android:textAllCaps="false"
                android:textColor="@color/on_surface" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="背景模糊"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_background_blur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/style_text_background_blur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted" />

        <CheckBox
            android:id="@+id/style_check_keep_screen_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="阅读时保持屏幕常亮"
            android:textColor="@color/on_surface" />

        <CheckBox
            android:id="@+id/style_check_show_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="章节首页显示标题"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="背景图"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_button_pick_background"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="选择背景"
                android:textColor="@color/primary" />

            <Button
                android:id="@+id/style_button_clear_background"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="恢复预设"
                android:textColor="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/style_text_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="自定义主题"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <Button
            android:id="@+id/style_button_save_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button"
            android:minHeight="44dp"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="保存当前主题"
            android:textColor="@color/primary" />

        <LinearLayout
            android:id="@+id/style_custom_theme_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />


    </LinearLayout>

</ScrollView>
