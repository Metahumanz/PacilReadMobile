<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/style_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_toc_fullscreen">

    <ScrollView
        android:id="@+id/style_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/style_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="阅读样式"
            android:textColor="?attr/themeColorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="调整文字、边距和阅读主题，滑动时可直接预览效果。"
            android:textColor="?attr/themeColorOnSurfaceMuted"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/themeColorDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="界面明暗"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/style_spinner_ui_theme_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <CheckBox
            android:id="@+id/style_check_double_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="44dp"
            android:text="平板/横屏双页"
            android:textColor="?attr/themeColorOnSurface" />

        <Spinner
            android:id="@+id/style_spinner_double_page_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="阅读预设"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_button_theme_paper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="纸控"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorOnSurface" />

            <Button
                android:id="@+id/style_button_theme_forest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="护眼"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorOnSurface" />

            <Button
                android:id="@+id/style_button_theme_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="夜航"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorOnSurface" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字体"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/style_spinner_font_family"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字色"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/style_spinner_text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/style_text_text_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:text="字色预览"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <Button
            android:id="@+id/style_button_custom_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button"
            android:minHeight="44dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="自定义字色（RGB）"
            android:textAllCaps="false"
            android:textColor="?attr/themeColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字号"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <TextView
            android:id="@+id/style_text_font"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字重"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_font_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2" />

        <TextView
            android:id="@+id/style_text_font_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="行距"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_line_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="28" />

        <TextView
            android:id="@+id/style_text_line_spacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="段间距"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_paragraph_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32" />

        <TextView
            android:id="@+id/style_text_paragraph_spacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="左边距"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_left_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="48" />

        <TextView
            android:id="@+id/style_text_left_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="右边距"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_right_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="48" />

        <TextView
            android:id="@+id/style_text_right_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="上边距"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_top_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="64" />

        <TextView
            android:id="@+id/style_text_top_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="下边距"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_bottom_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="64" />

        <TextView
            android:id="@+id/style_text_bottom_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字间距"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_letter_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <TextView
            android:id="@+id/style_text_letter_spacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="首行缩进"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_first_line_indent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="8" />

        <TextView
            android:id="@+id/style_text_first_line_indent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="正文对齐"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_button_body_justify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="两端对齐"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorOnSurface" />

            <Button
                android:id="@+id/style_button_body_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="左对齐"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorOnSurface" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="章节标题对齐"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_button_title_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="靠左"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorOnSurface" />

            <Button
                android:id="@+id/style_button_title_center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="居中"
                android:textAllCaps="false"
                android:textColor="?attr/themeColorOnSurface" />
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="背景模糊"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/style_seek_background_blur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/style_text_background_blur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeColorOnSurfaceMuted" />

        <CheckBox
            android:id="@+id/style_check_keep_screen_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="阅读时保持屏幕常亮"
            android:textColor="?attr/themeColorOnSurface" />

        <CheckBox
            android:id="@+id/style_check_show_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="章节首页显示标题"
            android:textColor="?attr/themeColorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="背景图"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_button_pick_background"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="选择背景"
                android:textColor="?attr/themeColorPrimary" />

            <Button
                android:id="@+id/style_button_clear_background"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="恢复预设"
                android:textColor="?attr/themeColorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/style_text_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/themeColorOnSurfaceMuted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="自定义主题"
            android:textColor="?attr/themeColorOnSurface"
            android:textStyle="bold" />

        <Button
            android:id="@+id/style_button_save_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_outline_button"
            android:minHeight="44dp"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="保存当前主题"
            android:textColor="?attr/themeColorPrimary" />

        <LinearLayout
            android:id="@+id/style_custom_theme_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />


    </LinearLayout>

    </ScrollView>
</FrameLayout>
