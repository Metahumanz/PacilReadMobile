<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="替换规则"
        android:textColor="?attr/themeColorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/rules_input_pattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:hint="查找内容"
        android:padding="12dp"
        android:textColor="?attr/themeColorOnSurface"
        android:textColorHint="?attr/themeColorOnSurfaceMuted" />

    <EditText
        android:id="@+id/rules_input_replacement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="替换为（留空表示删除）"
        android:padding="12dp"
        android:textColor="?attr/themeColorOnSurface"
        android:textColorHint="?attr/themeColorOnSurfaceMuted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/rules_check_global"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全局规则"
            android:textColor="?attr/themeColorOnSurface" />

        <CheckBox
            android:id="@+id/rules_check_regex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="正则"
            android:textColor="?attr/themeColorOnSurface" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/rules_button_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_primary_button"
            android:text="添加"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/rules_text_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="?attr/themeColorOnSurfaceMuted"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/rules_body"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="10dp">

        <ListView
            android:id="@+id/rules_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="72dp"
            android:divider="?attr/themeColorDivider"
            android:dividerHeight="1dp"
            android:fastScrollEnabled="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/rules_scrubber_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bg_toc_scrubber_preview"
            android:elevation="8dp"
            android:maxWidth="220dp"
            android:maxLines="2"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:textColor="?attr/themeColorOnSurface"
            android:textSize="13sp"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/rules_scrubber_host"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_gravity="end">

            <View
                android:id="@+id/rules_scrubber_track"
                android:layout_width="9dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_toc_scrubber_track" />

            <View
                android:id="@+id/rules_scrubber_thumb"
                android:layout_width="26dp"
                android:layout_height="54dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_toc_scrubber_thumb"
                android:elevation="6dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
