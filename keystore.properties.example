# Copy this file to keystore.properties and fill in local values.
# Do not commit keystore.properties or the keystore file.
#
# storeFile can be relative to the repository root, or an absolute path.
# On Windows, prefer forward slashes in absolute paths:
# storeFile=C:/Users/your-name/Secrets/pacilread-release.jks

storeFile=pacilread-release.jks
storePassword=replace-with-store-password
keyAlias=pacilread
keyPassword=replace-with-key-password
